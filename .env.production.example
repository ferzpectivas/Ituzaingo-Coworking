# ---------------------------------------------------------------------------
# Configuración de producción – Espacio de Coworking de Ituzaingó
# Copiar como .env y completar antes de ejecutar `docker compose up -d`.
# ---------------------------------------------------------------------------

# Dominio público. Con un dominio real Caddy obtiene el certificado TLS.
# Para probar por IP usar :80
DOMAIN=coworking.ituzaingo.gob.ar

# Origen público exacto de la web, sin barra final (CORS y cookies).
WEB_ORIGIN=https://coworking.ituzaingo.gob.ar

# URL que usa el navegador para la API. Al publicar todo bajo el mismo
# dominio conviene la ruta relativa; Caddy la redirige al contenedor api.
NEXT_PUBLIC_API_URL=/api/v1

# Clave de firma de los JWT. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# No cambiarla con datos ya cargados: los documentos cifrados dependen de
# PERSONAL_DATA_KEY (o de JWT_SECRET si no se define).
JWT_SECRET=

# Clave independiente para cifrar documentos personales (AES-256-GCM).
# Si queda vacía se usa JWT_SECRET. Definirla antes de la primera carga y
# conservarla junto con los respaldos.
PERSONAL_DATA_KEY=

# true sólo si el sitio se publica por HTTPS.
COOKIE_SECURE=true

# true en el primer arranque (crea los datos demo). Pasar a false después.
SEED_ON_START=true

# Puertos publicados por Caddy.
HTTP_PORT=80
HTTPS_PORT=443
