# Puerto de la API
API_PORT=4000

# Origen permitido para el frontend (admite varios separados por coma)
WEB_ORIGIN=http://localhost:3000

# URL pública de la API usada por Next.js
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Detrás de nginx local (http://localhost), usar:
# WEB_ORIGIN=http://localhost
# NEXT_PUBLIC_API_URL=/api/v1

# Sólo en Render (u otro PaaS sin proxy): origen de la API para que Next
# publique /api/* bajo el mismo dominio. Se fija en el build; sin esta
# variable no hay rewrite (local y Caddy/nginx no la necesitan).
# API_ORIGIN=https://ituzaingo-coworking-api.onrender.com

# Sólo en Render: proceso que arranca `npm start` en cada servicio (api o web).
# render.yaml lo define; fuera de Render `npm start` levanta ambos.
# SERVICE_ROLE=web

# Secreto para firmar JWT (cambiar en producción)
JWT_SECRET=cambiar-este-secreto-en-produccion-ituzaingo-coworking

# Clave para cifrar documentos personales (AES-256-GCM).
# Si se omite se usa JWT_SECRET. No cambiarla con datos ya cargados.
PERSONAL_DATA_KEY=

# Cookies Secure (true sólo detrás de HTTPS)
COOKIE_SECURE=false

# Directorio de persistencia JSON
DATA_DIR=./data

# Semilla automática si no existen datos
SEED_ON_START=true
